{
  "expo": {
    "name": "Strides",
    "slug": "Strides",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "strides",
    "icon": "./assets/appIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashScreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#3971c2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.softwarepro.strides",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "F73ZDW26LC"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon.png",
        "backgroundColor": "#3971c2"
      },
      "package": "com.softwarepro.strides"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "91bfd0ea-c748-4c90-b1d9-79b2cbbac241"
      }
    },
    "owner": "fahadzahidd24"
  }
}
