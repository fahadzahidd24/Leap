{
  "expo": {
    "name": "Leap",
    "slug": "leap",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "leap",
    "icon": "./assets/appIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashScreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#3871c1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.softwarepro.leap",
      "buildNumber": "14",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized content and improve your app experience."
      },
      "appleTeamId": "F73ZDW26LC"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon.png",
        "backgroundColor": "#3871c1"
      },
      "package": "com.softwarepro.leap",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The app uses your location to support manager live tracking while you are working."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized content and improve your app experience."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "91bfd0ea-c748-4c90-b1d9-79b2cbbac241"
      }
    },
    "owner": "fahadzahidd24"
  }
}
